<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/streamRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Every non-video status element lives in this layer so clean-screen mode can guarantee
         that later status callbacks cannot make an overlay visible over the stream. The remote
         cursor is deliberately NOT here: it sits below, outside this layer, because D-pad
         pointer control only exists in clean-screen mode and must show the cursor over video. -->
    <FrameLayout
        android:id="@+id/overlayLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvConnecting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_status_chip"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp"
        android:text="Connecting..."
        android:textAlignment="center"
        android:textColor="@color/text_primary_dark"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="64dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_status_chip"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@color/text_primary_dark"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="LIVE · 192.168.1.20\nVIDEO  1920×1080 @ 60 · H.264\nNET    14000 kbps · loss 0.0%\nAUDIO  48 kHz stereo · 1536 kbps" />

    <!-- Top bar: connection-state chip (dot + short text) at start, labeled action buttons at
         end. Replaces the previous plain top-center status line and bottom-end audio button. -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_status_dot" />

            <TextView
                android:id="@+id/tvStreamStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Streaming 1920×1080@60" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/toolbarButtons"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_toolbar_pill"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStats"
                android:focusable="true"
                style="@style/Widget.LocalStream.ToolbarButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:contentDescription="@string/cd_stats_button"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/toolbar_stats"
                android:textColor="@color/text_primary_dark"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHideControls"
                android:focusable="true"
                style="@style/Widget.LocalStream.ToolbarButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:contentDescription="@string/cd_hide_button"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/toolbar_hide"
                android:textColor="@color/text_primary_dark"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeave"
                android:focusable="true"
                style="@style/Widget.LocalStream.ToolbarButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:contentDescription="@string/cd_leave_button"
                android:minWidth="0dp"
                android:paddingHorizontal="2dp"
                android:text="@string/toolbar_leave"
                android:textColor="@color/status_red"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvGestureHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="68dp"
        android:background="@drawable/bg_status_chip"
        android:gravity="center"
        android:maxWidth="520dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp"
        android:text="@string/mouse_gesture_hint"
        android:textColor="@color/text_primary_dark"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    </FrameLayout>

    <!-- Remote-mouse cursor overlay: a sibling ABOVE overlayLayer on purpose. Clean-screen
         mode hides overlayLayer, but the D-pad pointer (which only exists in clean screen)
         still has to draw this cursor over the video; StreamActivity controls its visibility
         via updateRemoteCursor. 16×24dp ≈ the size of a native 1080p PC cursor on a TV.

         cursorLayer is full-screen and marked as drawing (setWillNotDraw(false) in
         StreamActivity) so the window's SurfaceView transparent region never opens over the
         video. That region is recomputed only on layout; the cursor moves by translation, so
         with overlayLayer gone (clean screen) the frozen region used to swallow it. -->
    <FrameLayout
        android:id="@+id/cursorLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/tvRemoteCursor"
            android:layout_width="16dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/ic_remote_cursor"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
