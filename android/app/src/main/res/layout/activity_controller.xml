<?xml version="1.0" encoding="utf-8"?>
<!-- Controller-role screen (§2.1): text composer on top (tap → phone keyboard → PC caret),
     touchpad in the middle, mouse buttons and two essential keys along the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvControllerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/controller_status_connecting"
        android:textColor="@color/text_secondary_dark"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etRemoteText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/surface_dark"
        android:hint="@string/controller_text_hint"
        android:imeOptions="actionSend"
        android:importantForAutofill="no"
        android:inputType="text"
        android:padding="12dp"
        android:singleLine="true"
        android:textColor="@color/text_primary_dark"
        android:textColorHint="@color/text_secondary_dark"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/touchpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@color/surface_dark"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/controller_touchpad_hint"
        android:textColor="@color/text_secondary_dark"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLeftClick"
            style="@style/Widget.DeskStream.ToolbarButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/mouse_left"
            android:textColor="@color/text_primary_dark"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRightClick"
            style="@style/Widget.DeskStream.ToolbarButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/mouse_right"
            android:textColor="@color/text_primary_dark"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnter"
            style="@style/Widget.DeskStream.ToolbarButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/controller_key_enter"
            android:textColor="@color/text_primary_dark"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackspace"
            style="@style/Widget.DeskStream.ToolbarButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/controller_key_backspace"
            android:textColor="@color/text_primary_dark"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
