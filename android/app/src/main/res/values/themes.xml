<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.LocalStream" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>
    </style>

    <style name="Theme.LocalStream.Main" parent="Theme.LocalStream">
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <!-- Discovery and pairing: white surfaces, blue actions, dark status-bar icons. -->
    <style name="Theme.LocalStream.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/ls_blue</item>
        <item name="colorPrimaryVariant">@color/ls_blue_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/ls_teal</item>
        <item name="colorOnSurface">@color/ls_text_primary</item>
        <item name="android:textColorPrimary">@color/ls_text_primary</item>
        <item name="android:textColorSecondary">@color/ls_text_secondary</item>
        <item name="android:windowBackground">@color/ls_bg</item>
        <item name="android:statusBarColor">@color/ls_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/ls_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <!-- Dialogs (manual IP, role choice, help) get the same soft corners as the cards. -->
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.LocalStream.Medium</item>
    </style>

    <!-- Pairing is a full-screen step, not a floating dialog. -->
    <style name="Theme.LocalStream.Light.PairScreen">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowSoftInputMode">adjustResize|stateVisible</item>
    </style>

    <style name="ShapeAppearance.LocalStream.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.LocalStream.Button.Primary" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <style name="Widget.LocalStream.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/ls_blue</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/ls_stroke_strong</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="iconTint">@color/ls_blue</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <style name="Widget.LocalStream.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
    </style>

    <style name="Widget.LocalStream.PinBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_pin_box</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/ls_text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.LocalStream.Fullscreen" parent="Theme.LocalStream">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@color/black</item>
        <item name="android:statusBarColor" tools:targetApi="lollipop">@color/black</item>
    </style>

    <!-- Stream-toolbar MaterialButton: same TextButton metrics, but D-pad focus, selection
         and press light the pill (toolbar_button_bg selector) so a TV remote always shows
         where it has landed — the stock dark state was invisible on the dark toolbar. -->
    <style name="Widget.LocalStream.ToolbarButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="backgroundTint">@color/toolbar_button_bg</item>
    </style>
</resources>
