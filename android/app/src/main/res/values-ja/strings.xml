    <!-- First-time pairing screen -->
    <string name="pair_title">初回ペアリング</string>
    <string name="pair_lead">PC側に表示される6桁のPINを入力して、初回ペアリングを行います。</string>
    <string name="pair_instruction">PC側の画面に表示されている6桁のPINを入力してください。</string>
    <string name="pair_note">PINの有効期限は60秒です（入力は3回まで）。</string>
    <string name="pair_error_length">6桁すべて入力してください</string>
    <string name="pair_error_wrong">PINが違います。あと%1$d回入力できます。</string>
    <string name="pair_verifying">PINを確認しています…</string>
    <string name="pair_requesting">新しいPINを取得しています…</string>
    <string name="pair_new_pin">新しいPINをPCに表示しました。</string>
    <string name="pair_request_pin">PINを再取得する</string>
    <string name="pair_help_title">ペアリングについて</string>
    <string name="pair_help_body">PINはPCで動作しているLocalStreamサーバーのウィンドウに表示されます。\n\n• 有効期限は60秒です。期限が切れたら「PINを再取得する」をタップしてください。\n• 3回間違えると接続が切断されます。\n• ペアリングは最初の1回だけです。次回からはPCを選ぶだけで接続できます。</string>
    <string name="cd_back">戻る</string>
    <string name="cd_help">ヘルプ</string>
    <string name="cd_pin_field">6桁のPIN</string>

